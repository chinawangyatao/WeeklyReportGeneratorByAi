# DeepSeek API key - 每个用户填自己的 key(本文件作为模板入库,.env 不入库)
# 获取: https://platform.deepseek.com/api_keys
# 用法: 复制本文件为 .env 并填入 key,或运行 `npm run setup` 交互式配置
DEEPSEEK_API_KEY=

# 腾讯文档 Token(可选,用于把周报写入腾讯文档)
# 获取: https://docs.qq.com/scenario/open-claw.html
TENCENT_DOCS_TOKEN=

# 周报用的腾讯文档表(可选;默认是作者的表,换成你自己的)
# file_id 是腾讯文档链接里 /sheet/ 后面那段;tab= 后面是子表 id
# WEEKLY_HR_FILE_ID=       # 人力管理表 file_id
# WEEKLY_PLAN_FILE_ID=     # 迭代规划表 file_id
# WEEKLY_PLAN_SHEET_ID=    # 迭代规划表里"最新-事项整理"子表 id
